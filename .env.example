# Copy to .env for local development. Never commit .env; set production values in the host's dashboard.

# ── API server (server.ts) ──
# Port the API listens on. Render sets this automatically.
PORT=3001
# Folder for project storage. Production uses Neon and R2; this is for local development only.
PAPERDESK_DATA=./backend/storage
# Docker image used to compile LaTeX.
LATEX_DOCKER_IMAGE=paperdesk-texlive:latest

# Set to 1 when the API runs behind one proxy, so rate limits see the real client IP.
TRUST_PROXY=0

# ── Production storage ──
# Leave these unset for local filesystem storage. Production requires all values.
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PAPERDESK_CORS_ORIGINS=
COMPILE_MODE=docker
COMPILE_TIMEOUT_MS=120000
MAX_COMPILE_TIMEOUT_MS=600000
COMPILE_MEMORY_MB=384
MAX_PROJECT_BYTES=26214400

# ── Assistant (POST /api/assistant) ──
# Server-side assistant key. Leave empty to turn the assistant off: the panel then says "Assistant not configured".
# Put the real key in .env locally or in Render's dashboard; never commit it and never prefix it with VITE_.
ANTHROPIC_API_KEY=
# Model the assistant uses.
ASSISTANT_MODEL=claude-haiku-4-5-20251001
# Questions allowed per client IP per hour.
ASSISTANT_RATE_LIMIT=30
# Largest request body the assistant accepts, in KB (question, history and shared editor context).
ASSISTANT_MAX_REQUEST_KB=256

# ── Frontend (Vite) ──
# Anything prefixed VITE_ is compiled into the public bundle: never put a secret here.
# Base URL of the API for production builds; leave empty locally (Vite proxies /api to :3001).
# VITE_API_URL=https://paperdesk-api.onrender.com
