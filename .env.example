# Copy to .env for local development. Never commit .env; set production values in the host's dashboard.

# ── API server (server.ts) ──
# Port the API listens on. Render sets this automatically.
PORT=3001
# Folder for project storage. Defaults to ./backend/storage; use a persistent disk in production.
PAPERDESK_DATA=./backend/storage
# Docker image used to compile LaTeX.
LATEX_DOCKER_IMAGE=paperdesk-texlive:latest

# Set to 1 when the API runs behind one proxy (Render does this), so rate limits see the real client IP.
# TRUST_PROXY=1

# ── Assistant (POST /api/assistant) ──
# Anthropic API key. Leave empty to turn the assistant off: the panel then says "Assistant not configured".
# Put the real key in .env locally or in Render's dashboard; never commit it and never prefix it with VITE_.
ANTHROPIC_API_KEY=
# Model the assistant uses.
ASSISTANT_MODEL=claude-haiku-5-5
# Questions allowed per client IP per hour.
ASSISTANT_RATE_LIMIT=30
# Largest request body the assistant accepts, in KB (question, history and shared editor context).
ASSISTANT_MAX_REQUEST_KB=256

# ── Frontend (Vite) ──
# Anything prefixed VITE_ is compiled into the public bundle: never put a secret here.
# Base URL of the API for production builds (planned; the dev server proxies /api to :3001 instead).
# VITE_API_URL=https://paperdesk-api.onrender.com
