# Copy to .env for local development. Never commit .env; set production values in the host's dashboard.

# ── API server (server/index.ts) ──
# Port the API listens on. Render sets this automatically.
PORT=3001
# Folder for project storage. Production uses Neon and R2; this is for local development only.
PAPERDESK_DATA=./backend/storage
# Docker image used to compile LaTeX.
LATEX_DOCKER_IMAGE=paperdesk-texlive:latest

# Set to 1 when the API runs behind one proxy, so rate limits see the real client IP.
TRUST_PROXY=0

# ── Production storage ──
# Leave these unset for local filesystem storage. Production requires all values.
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PAPERDESK_CORS_ORIGINS=
COMPILE_MODE=docker
COMPILE_TIMEOUT_MS=120000
MAX_COMPILE_TIMEOUT_MS=600000
COMPILE_MEMORY_MB=384
MAX_PROJECT_BYTES=26214400
# How many warm compile folders (one per project and compiler) the server keeps for fast recompiles.
# COMPILE_WORKSPACES=8

# ── Assistant (POST /api/assistant) ──
# Server-side assistant key. Leave empty to turn the assistant off: the panel then says "Assistant not configured".
# Put the real key in .env locally or in Render's dashboard; never commit it and never prefix it with VITE_.
ANTHROPIC_API_KEY=
# Model the assistant uses.
ASSISTANT_MODEL=claude-haiku-4-5-20251001
# Questions allowed per client IP per hour.
ASSISTANT_RATE_LIMIT=30
# Largest request body the assistant accepts, in KB (question, history and shared editor context).
ASSISTANT_MAX_REQUEST_KB=256

# ── Accounts (Supabase Auth; sign-in only, projects stay in Neon + R2) ──
# Project URL from Supabase → Project Settings → API (public, not a secret). Leave empty to turn sign-in off:
# the app then works as before, with projects tied to each browser.
SUPABASE_URL=
# Only for Supabase projects that still sign tokens with the legacy shared secret (Project Settings → JWT Keys).
# New projects use published signing keys and need nothing here. Secret: set it in Render's dashboard, never in git.
SUPABASE_JWT_SECRET=
# Tests only: inline JWKS JSON the API trusts instead of the Supabase project's keys. Never set this in production.
# SUPABASE_JWKS=

# ── Invitation emails (Brevo transactional email) ──
# Leave empty to send no email: an invitation is then a link the owner copies and passes on.
# API key from Brevo → Settings → SMTP & API → API keys. Secret: set it in Render's dashboard, never in git.
BREVO_API_KEY=
# The address invitations come from. It must be a verified sender in Brevo (Settings → Senders, domains, IPs).
MAIL_FROM=

# ── GitHub sync (File → GitHub sync) ──
# Leave all three empty to switch it off: the dialog then says "GitHub sync not configured".
# Client ID and secret of a GitHub OAuth App (GitHub → Settings → Developer settings → OAuth Apps) whose
# "Authorization callback URL" is <API origin>/api/github/callback. The ID is public; the secret is not.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any long random string (for example `openssl rand -base64 32`). People's GitHub tokens are encrypted with it
# before they are stored; changing it disconnects everyone. Secret: set it in Render's dashboard, never in git.
TOKEN_ENCRYPTION_KEY=

# ── Citations (Add citation by DOI / arXiv ID) ──
# Contact email sent to Crossref in the User-Agent, as its API etiquette asks. Not a secret; any address you read.
CROSSREF_MAILTO=

# ── Frontend (Vite) ──
# Anything prefixed VITE_ is compiled into the public bundle: never put a secret here.
# Base URL of the API for production builds; leave empty locally (Vite proxies /api to :3001).
# VITE_API_URL=https://paperdesk-api-juq2.onrender.com
# Supabase sign-in in the browser: the same Project URL and the publishable ("anon") key. Both are public by design
# (row access is enforced by PaperDesk's API, not by this key). Set them in GitLab → Settings → CI/CD → Variables.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
