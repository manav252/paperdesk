FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    COMPILE_MODE=native \
    PAPERDESK_DATA=/tmp/paperdesk \
    MAX_COMPILE_TIMEOUT_MS=120000 \
    COMPILE_MEMORY_MB=320 \
    MAX_PROJECT_BYTES=10485760

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates fontconfig util-linux \
      latexmk biber \
      texlive-latex-base texlive-latex-recommended texlive-latex-extra \
      texlive-fonts-recommended texlive-pictures texlive-publishers \
      texlive-bibtex-extra texlive-xetex texlive-luatex \
      texlive-font-utils ghostscript \
    && fc-cache -fs \
    && luaotfload-tool --update --force \
    && rm -rf /var/lib/apt/lists/* /tmp/*

ENV NODE_OPTIONS=--max-old-space-size=128

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY server.ts ./server.ts
COPY src/lib/latexLog.ts src/lib/synctex.ts ./src/lib/
COPY server/assistant.ts server/persistence.ts server/workspace.ts ./server/

EXPOSE 10000
CMD ["node", "--import", "tsx", "server.ts"]
